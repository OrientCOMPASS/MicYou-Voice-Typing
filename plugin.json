{
  "id": "opss.voice-typing",
  "name": "Voice-Typing",
  "runtime": "native",
  "version": "0.1.0",
  "description": "Windows端的语音输入法，依赖WhatdidIsay",
  "license": "Unlicense",
  "platforms": ["windows"],
  "arches":["x86_64"],
  "entry": "micyou_voice_typing",
  "updateUrl": "https://micyou-dev.github.io/MicYou-Plugins/plugin/opss.voice-typing/plugin.json",
  "downloadUrl": "https://github.com/OrientCOMPASS/MicYou-Voice-Typing/releases/download/v0.1.0/opss.voice-typing.zip",
  "apiVersion": 1,
  "dependencies": [
  { "id": "opss.whatdidisay", "version": "^0.2.5", "optional": false }
],
  "capabilities": [
    "config.read",
    "config.write"
  ],
  "config": {
    "mode": "toggle"
  },
  "configSchema": {
    "fields": [
      {
        "key": "mode",
        "fieldType": "select",
        "label": "触发模式 (快捷键固定为 LCtrl + LShift)",
        "default": "toggle",
        "options": [
          { "value": "toggle", "label": "按键切换 (Toggle)" },
          { "value": "push_to_talk", "label": "长按说话 (Push-to-Talk)" }
        ]
      }
    ]
  }
}